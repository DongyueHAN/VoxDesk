# DeepSeek API 配置模板
#
# 用法：复制一份，填上真 key
#     Copy-Item .env.example .env
#     # 然后编辑 .env，把下面这行改成你的 key
#
# 注意：
#   * .env 已被根 .gitignore 忽略（`.env` + `.env.*`），不会被提交
#   * 本文件（.env.example）会被提交，**不要往里写真 key**
#   * 程序读取顺序：已有的环境变量 > 当前目录/.env > demo/.env > 仓库根/.env

DEEPSEEK_API_KEY=

# 可选：换模型（默认 deepseek-chat；推理型可用 deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：换接入点（默认官方 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
